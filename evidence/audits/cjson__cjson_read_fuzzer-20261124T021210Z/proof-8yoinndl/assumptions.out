Corelib.Numbers.Cyclic.Int63.Uint63Axioms.lsr_spec :
  forall x p : Corelib.Numbers.Cyclic.Int63.PrimInt63.int,
  Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z
    (Corelib.Numbers.Cyclic.Int63.PrimInt63.lsr x p) =
  (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z x /
   2 ^ Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z p)%Z
