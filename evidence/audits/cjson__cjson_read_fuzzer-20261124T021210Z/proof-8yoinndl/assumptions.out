Corelib.Numbers.Cyclic.Int63.Uint63Axioms.of_to_Z :
  forall x : Corelib.Numbers.Cyclic.Int63.PrimInt63.int,
  Corelib.Numbers.Cyclic.Int63.Uint63Axioms.of_Z
    (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z x) =
