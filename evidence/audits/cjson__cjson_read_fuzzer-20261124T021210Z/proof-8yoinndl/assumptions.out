Corelib.Numbers.Cyclic.Int63.Uint63Axioms.sub_spec :
  forall x y : Corelib.Numbers.Cyclic.Int63.PrimInt63.int,
  Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z
    (Corelib.Numbers.Cyclic.Int63.PrimInt63.sub x y) =
  ((Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z x -
    Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z y)
   mod Corelib.Numbers.Cyclic.Int63.Uint63Axioms.wB)%Z
Corelib.Strings.PrimStringAxioms.sub_spec :
  forall (s : Corelib.Strings.PrimString.string)
    (off len : Corelib.Numbers.Cyclic.Int63.PrimInt63.int),
  Corelib.Strings.PrimStringAxioms.to_list
    (Corelib.Strings.PrimString.sub s off len) =
  Corelib.Lists.ListDef.firstn
    (Corelib.BinNums.IntDef.Z.to_nat
       (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z len))
    (Corelib.Lists.ListDef.skipn
       (Corelib.BinNums.IntDef.Z.to_nat
          (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z off))
       (Corelib.Strings.PrimStringAxioms.to_list s))
