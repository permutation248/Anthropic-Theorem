Corelib.Strings.PrimStringAxioms.make_spec :
  forall (i : Corelib.Numbers.Cyclic.Int63.PrimInt63.int)
    (c : Corelib.Strings.PrimString.char63),
  Corelib.Strings.PrimStringAxioms.to_list
    (Corelib.Strings.PrimString.make i c) =
  Corelib.Lists.ListDef.repeat
    (Corelib.Numbers.Cyclic.Int63.PrimInt63.land c 0xff)
    (Corelib.Init.Nat.min
       (Corelib.BinNums.IntDef.Z.to_nat
          (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z i))
       (Corelib.BinNums.IntDef.Z.to_nat
          (Corelib.Numbers.Cyclic.Int63.Uint63Axioms.to_Z
             Corelib.Strings.PrimString.max_length)))
Corelib.Strings.PrimString.make :
  Corelib.Numbers.Cyclic.Int63.PrimInt63.int ->
  Corelib.Strings.PrimString.char63 -> Corelib.Strings.PrimString.string
